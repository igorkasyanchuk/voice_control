<section class="table-card">
  <div class="section-heading">
    <h2>Make it yours</h2>
    <span>Saved across visits</span>
  </div>

  <%= form_with model: workspace_settings, scope: :settings, url: settings_path, method: :patch, id: "workspace-settings", class: "settings-form" do |form| %>
    <%= render "shared/errors", record: workspace_settings %>
    <%= form.label :workspace_name, "Workspace name", for: "workspace-name" %>
    <%= form.text_field :workspace_name, id: "workspace-name", maxlength: 100, required: true %>
    <%= form.label :workspace_note, "Workspace note", for: "workspace-note" %>
    <%= form.text_area :workspace_note, id: "workspace-note", rows: 3, maxlength: 2000, placeholder: "A note for your team" %>
    <%= form.label :discount_percent, "Discount percentage" %>
    <%= form.number_field :discount_percent, min: 0, max: 100, step: 0.01, required: true %>

    <label class="checkbox-label">
      <%= form.check_box :notifications %> Enable notifications
    </label>

    <p>
      Try “fill workspace name with Studio North”, then “click Save settings”.
    </p>

    <%= form.button "Save settings", id: "save-settings", type: "submit" %>
  <% end %>
</section>
