<section class="table-card schedule-preview">
  <h2>Schedule a delivery</h2>

  <p>
    Try “set due date to October 1” or “set start time to 14:30”. These practice
    fields are not saved.
  </p>

  <div class="settings-form">
    <label for="delivery-due-date">Due date</label>

    <input
      id="delivery-due-date"
      type="date"
      name="due_date"
      autocomplete="off"
    >

    <label for="delivery-start-time">Start time</label>

    <input
      id="delivery-start-time"
      type="time"
      name="start_time"
      autocomplete="off"
    >
  </div>
</section>
