#!/usr/bin/env ruby
ENV["BUNDLE_GEMFILE"] = File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
Dir.chdir(File.expand_path("../test/dummy", __dir__))
abort "Could not prepare the demo database" unless system("bundle", "exec", "ruby", "bin/rails", "db:prepare")
exec "bundle", "exec", "puma", "-b", "tcp://127.0.0.1:#{ENV.fetch('PORT', '4100')}", "config.ru"
